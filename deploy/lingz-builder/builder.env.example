# Lingz server-side image builder config.
# Copy this file to builder.env and adjust it for the build server.

# Git repository to build.
REPO_URL=http://git.zhoujusoft.com/ai/lingzhou-agent.git
REPO_REF=dev
# Optional HTTP auth. Prefer passing GIT_HTTP_TOKEN from shell instead of saving it here.
GIT_HTTP_USERNAME=oauth2
GIT_HTTP_TOKEN=
# Create and push this Git tag only after both images are pushed successfully.
CREATE_GIT_TAG=true
GIT_TAG_PREFIX=
GIT_TAGGER_NAME=Lingz Builder
GIT_TAGGER_EMAIL=lingz-builder@localhost

# Local checkout and build workspace.
WORK_DIR=/opt/lingz-builder/workspace
REPO_DIR=/opt/lingz-builder/workspace/lingzhou-agent

# Docker image settings.
REGISTRY=125.75.152.167:5001
# Used as both Docker image tag and Git tag when no tag is passed directly.
IMAGE_TAG=1.7.0
FRONTEND_IMAGE_NAME=lingzhou-frontend
BACKEND_IMAGE_NAME=lingzhou-backend

# Optional: linux/amd64 by default. Use linux/arm64 on arm64 servers.
TARGET_PLATFORM=linux/amd64

# Build options.
SKIP_TESTS=true
BACKEND_BUILD_MODE=docker
BACKEND_BUILD_IMAGE=maven:3.9-eclipse-temurin-17
SKIP_FRONTEND_INSTALL=false
FRONTEND_BUILD_MODE=docker
FRONTEND_BUILD_IMAGE=node:20-alpine
FRONTEND_BUILD_CONTAINER_USER=root
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
NPM_REGISTRY=https://registry.npmmirror.com
PNPM_REGISTRY=https://registry.npmmirror.com
PNPM_VERSION=9.15.9
VITE_BASE_PATH=/
VITE_BASE_URL=

# Tool bootstrap.
# When true, the script will try to install missing git/maven/node/pnpm/docker/buildx.
INSTALL_MISSING_TOOLS=false
NODE_MAJOR_VERSION=20
# CentOS 7 official mirrorlist is unavailable on many servers.
# When true, the script rewrites CentOS 7 yum base repos to this vault mirror before yum install.
AUTO_CONFIGURE_CENTOS7_YUM=true
CENTOS7_YUM_MIRROR=https://mirrors.aliyun.com/centos-vault/7.9.2009

# Backend image wheel target platform. Leave empty to infer from TARGET_PLATFORM.
PIP_PLATFORM=

# Optional docker login. Prefer logging in manually on the server.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
